# Legal Drafting Assistant Environment Configuration
# Copy this file to .env and configure as needed. Never commit .env to source control.

# Optional external LLM endpoint for augmented drafting (Ollama, Groq, or Gemini)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=

# Persistence directory for drafted clauses and evaluation records
DATA_PATH=data/app.json
